# Connexion au projet Supabase (base de données + comptes admin).
#
# Sans ces deux variables, le site démarre en MODE DÉMONSTRATION : les données
# vivent dans le localStorage du navigateur, avec un jeu de données de départ.
#
# Pour brancher la vraie base :
#   1. Créez un projet sur https://supabase.com
#   2. Exécutez supabase/schema.sql dans l'éditeur SQL du projet
#   3. Créez le compte admin dans Authentication → Users
#   4. Copiez ce fichier en .env et renseignez les deux valeurs
#      (Project Settings → API)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
